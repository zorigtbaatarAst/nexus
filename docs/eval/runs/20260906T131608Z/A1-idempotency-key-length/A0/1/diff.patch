diff --git a/src/main/resources/db/migration/V4__widen_idempotency_key.sql b/src/main/resources/db/migration/V4__widen_idempotency_key.sql
new file mode 100644
index 0000000..12cf701
--- /dev/null
+++ b/src/main/resources/db/migration/V4__widen_idempotency_key.sql
@@ -0,0 +1,4 @@
+-- The new upstream provider issues idempotency keys longer than the original 64 chars.
+-- Widening a varchar in Postgres is a catalog-only change (no table rewrite), but it does
+-- take a brief ACCESS EXCLUSIVE lock on payment.
+ALTER TABLE payment ALTER COLUMN idempotency_key TYPE VARCHAR(128);
