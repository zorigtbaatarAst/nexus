+-- Restores ux_payment_idempotency_key, dropped by V3__drop_unused_indexes.sql.
+--
+-- The Q3 storage review read "no reads in pg_stat_user_indexes" as "unused". A unique index
+-- backing a constraint records no reads by design: it is enforced on write, not scanned on
+-- read. Dropping it removed the only cross-transaction guarantee behind idempotency and
+-- reopened the duplicate-payment race that V2__payment_unique_index.sql closed. The
+-- application check in PaymentService#create is an optimisation; on more than one node, two
+-- concurrent calls carrying the same key can both miss it and both insert.
+--
+-- Not "unused" — do not drop again on read statistics alone.
+CREATE UNIQUE INDEX ux_payment_idempotency_key ON payment (idempotency_key);
