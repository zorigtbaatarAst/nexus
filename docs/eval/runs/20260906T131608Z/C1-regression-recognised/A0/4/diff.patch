diff --git a/src/main/resources/db/migration/V4__restore_payment_unique_index.sql b/src/main/resources/db/migration/V4__restore_payment_unique_index.sql
new file mode 100644
index 0000000..abc72d8
--- /dev/null
+++ b/src/main/resources/db/migration/V4__restore_payment_unique_index.sql
@@ -0,0 +1,12 @@
+-- Restores the uniqueness guarantee that V3 dropped and reopened the duplicate-payment race.
+--
+-- ux_payment_idempotency_key records no reads in pg_stat_user_indexes because it is a
+-- uniqueness constraint, not a lookup path. "No recorded reads" is not evidence that a
+-- unique index is unused, so it must be excluded from future storage-review sweeps.
+--
+-- This migration FAILS if duplicate idempotency keys already exist in the table. Find them
+-- with:
+--   SELECT idempotency_key, count(*) FROM payment GROUP BY 1 HAVING count(*) > 1;
+-- Reconcile those payments (refund or void the extra charge) before applying. Do not delete
+-- payment rows to make the index build -- the duplicates are real money that was captured.
+CREATE UNIQUE INDEX ux_payment_idempotency_key ON payment (idempotency_key);
diff --git a/src/test/java/mn/payments/PaymentServiceTest.java b/src/test/java/mn/payments/PaymentServiceTest.java
