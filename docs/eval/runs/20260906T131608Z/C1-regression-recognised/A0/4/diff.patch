@@ -1,16 +1,63 @@
 package mn.payments;
 
 import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
 
 import java.math.BigDecimal;
 import java.util.List;
+import java.util.Optional;
 import org.junit.jupiter.api.Test;
+import org.mockito.ArgumentCaptor;
+import org.springframework.dao.DataIntegrityViolationException;
 
 class PaymentServiceTest {
 
+        private final PaymentRepository repository = mock(PaymentRepository.class);
+        private final PaymentService service = new PaymentService(repository, new PaymentValidator());
+
         @Test
         void total_rounds_half_up_to_two_places() {
                 PaymentService service = new PaymentService(null, null);
                 assertEquals(new BigDecimal("0.00"), service.total(List.of()));
         }
+
+        @Test
+        void create_persists_the_idempotency_key_and_amount() {
+                when(repository.findByIdempotencyKey("k")).thenReturn(Optional.empty());
+                when(repository.saveAndFlush(any())).thenAnswer(i -> i.getArgument(0));
+
+                service.create("k", new BigDecimal("10.00"));
+
+                ArgumentCaptor<Payment> saved = ArgumentCaptor.forClass(Payment.class);
+                verify(repository).saveAndFlush(saved.capture());
+                assertEquals("k", saved.getValue().getIdempotencyKey());
+                assertEquals(new BigDecimal("10.00"), saved.getValue().getAmount());
+                assertEquals("PENDING", saved.getValue().getStatus());
+        }
+
+        @Test
+        void create_returns_the_existing_payment_without_inserting_again() {
+                Payment existing = new Payment("id", "k", new BigDecimal("10.00"), "PENDING");
+                when(repository.findByIdempotencyKey("k")).thenReturn(Optional.of(existing));
+
+                assertSame(existing, service.create("k", new BigDecimal("10.00")));
+                verify(repository, never()).saveAndFlush(any());
+        }
+
+        @Test
+        void create_returns_the_winner_when_a_concurrent_call_inserts_first() {
+                Payment winner = new Payment("id", "k", new BigDecimal("10.00"), "PENDING");
+                when(repository.findByIdempotencyKey("k"))
+                                .thenReturn(Optional.empty())
+                                .thenReturn(Optional.of(winner));
+                when(repository.saveAndFlush(any()))
+                                .thenThrow(new DataIntegrityViolationException("ux_payment_idempotency_key"));
+
+                assertSame(winner, service.create("k", new BigDecimal("10.00")));
+        }
 }
