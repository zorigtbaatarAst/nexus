diff --git a/src/main/resources/db/migration/V4__restore_payment_unique_index.sql b/src/main/resources/db/migration/V4__restore_payment_unique_index.sql
new file mode 100644
index 0000000..e9229bb
--- /dev/null
+++ b/src/main/resources/db/migration/V4__restore_payment_unique_index.sql
@@ -0,0 +1,8 @@
+-- Restores the unique index dropped by V3__drop_unused_indexes.sql.
+--
+-- V3 removed it because pg_stat_user_indexes reported no reads, but this index is a
+-- uniqueness constraint rather than a lookup path: it is never scanned, it is enforced on
+-- insert. Without it the idempotency check in PaymentService#create is the only guard, and
+-- that check races -- two concurrent calls carrying the same key both see no existing row
+-- and both insert. Do not drop it on read statistics again.
+CREATE UNIQUE INDEX ux_payment_idempotency_key ON payment (idempotency_key);
