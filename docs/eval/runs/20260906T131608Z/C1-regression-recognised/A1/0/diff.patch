+
+    /**
+     * The regression from V3: with the unique constraint gone, the loser of this race
+     * inserted a second row and the caller was charged twice. With the constraint back, the
+     * insert is rejected and the caller gets the winner's payment.
+     */
+    @Test
+    void losing_the_insert_race_returns_the_existing_payment_instead_of_charging_twice() {
+        PaymentRepository repository = mock(PaymentRepository.class);
+        PaymentWriter writer = mock(PaymentWriter.class);
+        Payment winner = new Payment();
+        winner.setIdempotencyKey("k1");
+
+        when(writer.createIfAbsent(eq("k1"), any()))
+                .thenThrow(new DataIntegrityViolationException("ux_payment_idempotency_key"));
+        when(repository.findByIdempotencyKey("k1")).thenReturn(Optional.of(winner));
+
+        PaymentService service =
+                new PaymentService(repository, new PaymentValidator(), writer);
+
+        assertSame(winner, service.create("k1", new BigDecimal("10.00")));
+    }
+
+    @Test
+    void an_unrelated_constraint_violation_is_not_swallowed() {
+        PaymentRepository repository = mock(PaymentRepository.class);
+        PaymentWriter writer = mock(PaymentWriter.class);
+
+        when(writer.createIfAbsent(eq("k2"), any()))
+                .thenThrow(new DataIntegrityViolationException("amount must not be null"));
+        when(repository.findByIdempotencyKey("k2")).thenReturn(Optional.empty());
+
+        PaymentService service =
+                new PaymentService(repository, new PaymentValidator(), writer);
+
+        assertThrows(
+                DataIntegrityViolationException.class,
+                () -> service.create("k2", new BigDecimal("10.00")));
+    }
 }
