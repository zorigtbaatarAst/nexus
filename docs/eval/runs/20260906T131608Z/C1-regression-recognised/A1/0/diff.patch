diff --git a/src/main/java/mn/payments/PaymentWriter.java b/src/main/java/mn/payments/PaymentWriter.java
new file mode 100644
index 0000000..5a1479d
--- /dev/null
+++ b/src/main/java/mn/payments/PaymentWriter.java
@@ -0,0 +1,48 @@
+package mn.payments;
+
+import java.math.BigDecimal;
+import java.util.UUID;
+import org.springframework.stereotype.Component;
+import org.springframework.transaction.annotation.Transactional;
+
+/**
+ * The transactional half of {@link PaymentService#create}.
+ *
+ * <p>It is a separate bean on purpose. The unique constraint is enforced when the insert is
+ * flushed, which happens at commit -- after this method returns -- so the resulting
+ * exception cannot be caught, nor the winning row read back, inside the transaction that
+ * caused it. PaymentService therefore does that recovery outside this boundary. Calling it
+ * through an injected bean also keeps the transaction real: a self-invocation would bypass
+ * the proxy, which is how the original race was introduced in 51ed745.
+ */
+@Component
+public class PaymentWriter {
+
+    private final PaymentRepository repository;
+
+    PaymentWriter(PaymentRepository repository) {
+        this.repository = repository;
+    }
+
+    /**
+     * Returns the existing payment for {@code idempotencyKey}, or inserts a new one. The
+     * read and the insert share one transaction, but that alone only settles races within a
+     * single node -- ux_payment_idempotency_key (V4) settles the rest by rejecting the
+     * second row.
+     */
+    @Transactional
+    public Payment createIfAbsent(String idempotencyKey, BigDecimal amount) {
+        return repository
+                .findByIdempotencyKey(idempotencyKey)
+                .orElseGet(() -> repository.save(newPayment(idempotencyKey, amount)));
+    }
+
+    private static Payment newPayment(String idempotencyKey, BigDecimal amount) {
+        Payment p = new Payment();
+        p.setId(UUID.randomUUID().toString());
+        p.setIdempotencyKey(idempotencyKey);
+        p.setAmount(amount);
+        p.setStatus("PENDING");
+        return p;
+    }
+}
diff --git a/src/main/resources/db/migration/V4__restore_payment_idempotency_constraint.sql b/src/main/resources/db/migration/V4__restore_payment_idempotency_constraint.sql
new file mode 100644
index 0000000..3fe8ac2
--- /dev/null
+++ b/src/main/resources/db/migration/V4__restore_payment_idempotency_constraint.sql
@@ -0,0 +1,24 @@
+-- Restores the uniqueness guarantee that V3 removed.
+--
+-- V3 dropped ux_payment_idempotency_key because the Q3 storage review found no reads for it
+-- in pg_stat_user_indexes. It had no reads because it is a uniqueness guarantee, not a
+-- lookup path, and dropping it reopened the race V2 closed: the application check in
+-- PaymentService cannot settle two concurrent inserts of the same key -- under READ
+-- COMMITTED both transactions see no existing row and both insert. Only the database can
+-- settle that, and this is how it does it.
+--
+-- Restored as a table constraint rather than a bare index. The backing index still reports
+-- zero scans, so it will look just as "unused" at the next storage review -- but DROP INDEX
+-- now refuses to remove it while the constraint depends on it, which is the point.
+--
+-- OPERATOR NOTE: this migration fails if duplicates were written while the constraint was
+-- missing. Find them first:
+--
+--   SELECT idempotency_key, count(*), array_agg(id)
+--     FROM payment GROUP BY idempotency_key HAVING count(*) > 1;
+--
+-- Reconcile those (refund or void the extra charge) before deploying. Do not delete the
+-- extra rows blind: each one may already have been settled downstream, and dropping the
+-- record without reversing the charge hides the double charge instead of fixing it.
+ALTER TABLE payment
+  ADD CONSTRAINT ux_payment_idempotency_key UNIQUE (idempotency_key);
