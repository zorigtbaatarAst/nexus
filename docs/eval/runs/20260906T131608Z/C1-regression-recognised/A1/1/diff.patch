diff --git a/src/main/resources/db/migration/V4__restore_payment_idempotency_constraint.sql b/src/main/resources/db/migration/V4__restore_payment_idempotency_constraint.sql
new file mode 100644
index 0000000..8a8ad50
--- /dev/null
+++ b/src/main/resources/db/migration/V4__restore_payment_idempotency_constraint.sql
@@ -0,0 +1,10 @@
+-- Restores the uniqueness guarantee that V3 dropped and reopened the duplicate-payment race.
+--
+-- V3 removed ux_payment_idempotency_key because pg_stat_user_indexes recorded no reads
+-- against it. A uniqueness index is never read by a query plan -- it is enforced on write --
+-- so zero reads is its expected steady state, not evidence that it is unused.
+--
+-- Re-created as a named table constraint rather than a bare index so that it is visible in
+-- information_schema.table_constraints and is not a candidate for the next index sweep.
+ALTER TABLE payment
+  ADD CONSTRAINT ux_payment_idempotency_key UNIQUE (idempotency_key);
