diff --git a/src/main/resources/db/migration/V4__restore_payment_unique_index.sql b/src/main/resources/db/migration/V4__restore_payment_unique_index.sql
new file mode 100644
index 0000000..891953a
--- /dev/null
+++ b/src/main/resources/db/migration/V4__restore_payment_unique_index.sql
@@ -0,0 +1,16 @@
+-- Restores ux_payment_idempotency_key, which V3__drop_unused_indexes.sql dropped.
+--
+-- The Q3 storage review read pg_stat_user_indexes and saw zero index scans on this index,
+-- which is exactly what a uniqueness constraint looks like: nothing plans a lookup through
+-- it, the executor only consults it to reject a conflicting insert. Dropping it reopened the
+-- duplicate-payment race that V2 closed, and duplicates have been reaching production since.
+--
+-- Do NOT drop this index on read-count evidence. It is a correctness constraint, not a
+-- lookup path.
+--
+-- If this migration fails with "could not create unique index", duplicate rows landed while
+-- the index was missing. Do not delete payment rows to make it pass -- reconcile them first:
+--
+--   SELECT idempotency_key, count(*), array_agg(id ORDER BY id)
+--     FROM payment GROUP BY idempotency_key HAVING count(*) > 1;
+CREATE UNIQUE INDEX ux_payment_idempotency_key ON payment (idempotency_key);
