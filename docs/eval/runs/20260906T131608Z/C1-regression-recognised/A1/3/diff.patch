diff --git a/src/main/resources/db/migration/V4__restore_payment_unique_index.sql b/src/main/resources/db/migration/V4__restore_payment_unique_index.sql
new file mode 100644
index 0000000..0d86abc
--- /dev/null
+++ b/src/main/resources/db/migration/V4__restore_payment_unique_index.sql
@@ -0,0 +1,10 @@
+-- Restores the unique index that V2 added and V3__drop_unused_indexes.sql removed.
+--
+-- V3 read pg_stat_user_indexes, saw zero index scans on ux_payment_idempotency_key, and
+-- swept it up with the genuinely unused indexes. A uniqueness constraint records no reads
+-- by design: it is enforced on write, not consulted on read. Dropping it reopened the
+-- duplicate-payment race, because the application-level existsByIdempotencyKey check in
+-- PaymentService#create cannot see an uncommitted insert from a concurrent transaction.
+--
+-- Do not drop this index again on read-count evidence.
+CREATE UNIQUE INDEX ux_payment_idempotency_key ON payment (idempotency_key);
