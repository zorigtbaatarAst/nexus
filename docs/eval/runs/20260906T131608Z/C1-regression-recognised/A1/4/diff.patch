diff --git a/src/main/resources/db/migration/V4__restore_payment_idempotency_index.sql b/src/main/resources/db/migration/V4__restore_payment_idempotency_index.sql
new file mode 100644
index 0000000..f55716e
--- /dev/null
+++ b/src/main/resources/db/migration/V4__restore_payment_idempotency_index.sql
@@ -0,0 +1,15 @@
+-- Restores the unique index that V3 dropped.
+--
+-- V3 read "no reads in pg_stat_user_indexes" as "unused". A unique index that exists to
+-- reject duplicate inserts is never a lookup path, so it never records reads; the zero
+-- was the index doing its job, not evidence it was idle. Dropping it reopened the
+-- duplicate-payment race that V2 closed, and payments started double-charging again.
+--
+-- Do not drop this index on storage grounds. It is the arbiter for idempotency: the
+-- application check in PaymentService#create races across cluster nodes and cannot be.
+--
+-- If this migration fails with a uniqueness violation, the table already contains
+-- duplicate idempotency keys written while the index was missing. Those rows are real
+-- double charges and need reconciling before the index can be rebuilt:
+--   SELECT idempotency_key, count(*) FROM payment GROUP BY 1 HAVING count(*) > 1;
+CREATE UNIQUE INDEX ux_payment_idempotency_key ON payment (idempotency_key);
