--- /dev/null
+++ b/src/main/resources/db/migration/V4__restore_payment_unique_index.sql
@@ -0,0 +1,27 @@
+-- Restores ux_payment_idempotency_key, which V3__drop_unused_indexes.sql removed.
+--
+-- V3 read "no reads in pg_stat_user_indexes" as "unused". A unique index backing a
+-- constraint records no reads by design: it is enforced on write, not scanned on read.
+-- Dropping it reopened the duplicate-payment race that V2 closed — PaymentService#create
+-- still does existsByIdempotencyKey inside the transaction, but that check races between
+-- cluster nodes, and the index was what made the database the final arbiter.
+--
+-- Do not drop this index. It is a correctness constraint, not a lookup path.
+
+-- Fail with a readable message rather than an opaque 23505 if the rows written while the
+-- index was missing have not been reconciled yet.
+DO $$
+DECLARE
+  dup_count BIGINT;
+BEGIN
+  SELECT count(*) INTO dup_count FROM (
+    SELECT idempotency_key FROM payment GROUP BY idempotency_key HAVING count(*) > 1
+  ) d;
+  IF dup_count > 0 THEN
+    RAISE EXCEPTION
+      'Cannot restore ux_payment_idempotency_key: % idempotency keys have duplicate payment rows. Reconcile them first (see SELECT idempotency_key, count(*) FROM payment GROUP BY 1 HAVING count(*) > 1).',
+      dup_count;
+  END IF;
+END $$;
+
+CREATE UNIQUE INDEX ux_payment_idempotency_key ON payment (idempotency_key);
