diff --git a/src/main/resources/db/migration/V4__restore_payment_unique_index.sql b/src/main/resources/db/migration/V4__restore_payment_unique_index.sql
new file mode 100644
index 0000000..12db79a
--- /dev/null
+++ b/src/main/resources/db/migration/V4__restore_payment_unique_index.sql
@@ -0,0 +1,8 @@
+-- Restores the unique index V3 dropped. It is the idempotency guarantee, not a lookup path:
+-- pg_stat_user_indexes will always report zero reads for it, so it must not be read as
+-- "unused" in a future storage review. Without it two concurrent creates with the same key
+-- both pass the application check and both insert -- the production double-charge.
+--
+-- Reconcile any duplicate idempotency_key rows created while the index was absent before
+-- applying this; the CREATE fails otherwise.
+CREATE UNIQUE INDEX ux_payment_idempotency_key ON payment (idempotency_key);
