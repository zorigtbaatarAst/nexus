diff --git a/src/main/resources/db/migration/V4__restore_payment_unique_index.sql b/src/main/resources/db/migration/V4__restore_payment_unique_index.sql
new file mode 100644
index 0000000..ad18ba6
--- /dev/null
+++ b/src/main/resources/db/migration/V4__restore_payment_unique_index.sql
@@ -0,0 +1,14 @@
+-- Restores the uniqueness guarantee that V3__drop_unused_indexes.sql removed.
+--
+-- V3 dropped ux_payment_idempotency_key because pg_stat_user_indexes recorded no reads
+-- against it. That statistic does not mean what the storage review took it to mean: the
+-- index is a write-side constraint, not a lookup path, so it is never "read" by a query
+-- plan and its scan count stays at zero no matter how much work it is doing. Dropping it
+-- reopened the duplicate-payment race that V2 closed.
+--
+-- Do not drop this index on read-count evidence again.
+--
+-- NOTE FOR DEPLOY: this will fail if the payment table already contains rows sharing an
+-- idempotency_key -- which is exactly what the double charges in production are. The
+-- duplicates have to be reconciled before this migration can apply. See the deploy notes.
+CREATE UNIQUE INDEX ux_payment_idempotency_key ON payment (idempotency_key);
