+    /**
+     * Cancels a PENDING payment. The read and the write share the transaction so a payment
+     * cannot be cancelled twice, or cancelled while another call is moving it out of PENDING.
+     */
+    @Transactional
+    public Payment cancel(String paymentId) {
+        if (paymentId == null || paymentId.isBlank()) {
+            throw new IllegalArgumentException("payment id is required");
+        }
+        Payment p =
+                repository
+                        .findById(paymentId)
+                        .orElseThrow(
+                                () ->
+                                        new IllegalArgumentException(
+                                                "unknown payment: " + paymentId));
+        if (!"PENDING".equals(p.getStatus())) {
+            throw new IllegalStateException(
+                    "payment " + paymentId + " is " + p.getStatus() + ", not PENDING");
+        }
+        p.setStatus("CANCELLED");
+        return repository.save(p);
+    }
