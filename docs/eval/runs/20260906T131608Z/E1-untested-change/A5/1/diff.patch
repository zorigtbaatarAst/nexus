+    @Test
+    void cancel_moves_a_pending_payment_to_cancelled() {
+        PaymentRepository repository = mock(PaymentRepository.class);
+        Payment pending = new Payment();
+        pending.setStatus("PENDING");
+        when(repository.findById("p1")).thenReturn(Optional.of(pending));
+        when(repository.save(pending)).thenReturn(pending);
+
+        Payment cancelled = new PaymentService(repository, null).cancel("p1");
+
+        assertEquals("CANCELLED", cancelled.getStatus());
+        verify(repository).save(pending);
+    }
+
+    @Test
+    void cancel_rejects_a_payment_that_is_no_longer_pending() {
+        PaymentRepository repository = mock(PaymentRepository.class);
+        Payment settled = new Payment();
+        settled.setStatus("SETTLED");
+        when(repository.findById("p1")).thenReturn(Optional.of(settled));
+
+        PaymentService service = new PaymentService(repository, null);
+
+        assertThrows(IllegalStateException.class, () -> service.cancel("p1"));
+        assertEquals("SETTLED", settled.getStatus());
+        verify(repository, never()).save(any());
+    }
+
