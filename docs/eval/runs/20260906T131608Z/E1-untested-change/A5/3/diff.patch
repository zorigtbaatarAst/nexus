+    /**
+     * Cancels a payment that is still PENDING. Under READ_COMMITTED two concurrent cancels can
+     * both see PENDING and both write CANCELLED, which is harmless since the target state is
+     * the same; add a pessimistic read if a stricter guarantee is ever needed.
+     */
+    @Transactional
+    public Payment cancel(String paymentId) {
+        Payment p =
+                repository
+                        .findById(paymentId)
+                        .orElseThrow(
+                                () ->
+                                        new IllegalArgumentException(
+                                                "unknown payment: " + paymentId));
+        if (!"PENDING".equals(p.getStatus())) {
+            throw new IllegalStateException(
+                    "payment " + paymentId + " is " + p.getStatus() + ", not PENDING");
+        }
+        p.setStatus("CANCELLED");
+        return repository.save(p);
+    }
+
