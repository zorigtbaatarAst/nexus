+    /**
+     * Cancellation is only valid from PENDING; the read and the status write share this
+     * transaction so a concurrent cancel cannot see the same payment as still pending.
+     */
+    @Transactional
+    public Payment cancel(String paymentId) {
+        Payment p = repository.findById(paymentId).orElseThrow();
+        if (!"PENDING".equals(p.getStatus())) {
+            throw new IllegalStateException("payment is not PENDING: " + p.getStatus());
+        }
+        p.setStatus("CANCELLED");
+        return repository.save(p);
+    }
