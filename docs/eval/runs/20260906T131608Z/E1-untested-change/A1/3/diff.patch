+    /**
+     * Cancellation is only legal from PENDING, and the check runs inside the transaction so two
+     * concurrent cancels cannot both observe PENDING and double-transition the payment.
+     */
+    @Transactional
+    public Payment cancel(String paymentId) {
+        if (paymentId == null || paymentId.isBlank()) {
+            throw new IllegalArgumentException("payment id is required");
+        }
+        Payment p =
+                repository
+                        .findById(paymentId)
+                        .orElseThrow(
+                                () ->
+                                        new IllegalArgumentException(
+                                                "no payment with id " + paymentId));
+        if (!"PENDING".equals(p.getStatus())) {
+            throw new IllegalStateException(
+                    "cannot cancel payment in status " + p.getStatus());
+        }
+        p.setStatus("CANCELLED");
+        return repository.save(p);
+    }
+
