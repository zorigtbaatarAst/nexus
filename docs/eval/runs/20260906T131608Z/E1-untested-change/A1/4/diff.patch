+    /**
+     * Cancellation is only valid from PENDING, and the status check runs inside the transaction
+     * so two concurrent cancels cannot both observe PENDING and both proceed.
+     */
+    @Transactional
+    public Payment cancel(String paymentId) {
+        Payment p =
+                repository
+                        .findById(paymentId)
+                        .orElseThrow(
+                                () ->
+                                        new IllegalArgumentException(
+                                                "no such payment: " + paymentId));
+        if (!"PENDING".equals(p.getStatus())) {
+            throw new IllegalStateException(
+                    "cannot cancel payment in status " + p.getStatus());
+        }
+        p.setStatus("CANCELLED");
+        return repository.save(p);
+    }
