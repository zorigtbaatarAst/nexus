+    /**
+     * Cancels a PENDING payment. Any other status is rejected rather than silently ignored, so
+     * a double cancel or a cancel of a settled payment surfaces to the caller.
+     */
+    @Transactional
+    public Payment cancel(String paymentId) {
+        Payment p =
+                repository
+                        .findById(paymentId)
+                        .orElseThrow(
+                                () ->
+                                        new IllegalArgumentException(
+                                                "unknown payment: " + paymentId));
+        if (!"PENDING".equals(p.getStatus())) {
+            throw new IllegalStateException(
+                    "only a PENDING payment can be cancelled, was: " + p.getStatus());
+        }
+        p.setStatus("CANCELLED");
+        return repository.save(p);
+    }
