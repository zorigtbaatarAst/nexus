+    /** Moves a PENDING payment to CANCELLED. Any other status is rejected. */
+    @Transactional
+    public Payment cancel(String paymentId) {
+        Payment p = repository.findById(paymentId).orElseThrow(
+                () -> new IllegalArgumentException("unknown payment: " + paymentId));
+        if (!"PENDING".equals(p.getStatus())) {
+            throw new IllegalStateException(
+                    "payment " + paymentId + " is " + p.getStatus() + ", not PENDING");
+        }
+        p.setStatus("CANCELLED");
+        return repository.save(p);
+    }
