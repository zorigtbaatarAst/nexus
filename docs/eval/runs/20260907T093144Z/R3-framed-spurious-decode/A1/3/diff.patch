@@ -65,6 +65,12 @@ impl Default for WriteFrame {
 
 impl From<BytesMut> for ReadFrame {
     fn from(mut buffer: BytesMut) -> Self {
+        // Only start in the `framing` state if the buffer actually holds bytes
+        // that `decode` could turn into a frame. A buffer that is empty but has
+        // capacity (e.g. one recycled from `into_parts()`) must start in the
+        // `reading` state, otherwise we'd call `decode` before reading any IO.
+        let is_readable = !buffer.is_empty();
+
         let size = buffer.capacity();
         if size < INITIAL_CAPACITY {
             buffer.reserve(INITIAL_CAPACITY - size);
@@ -72,7 +78,7 @@ impl From<BytesMut> for ReadFrame {
 
         Self {
             buffer,
-            is_readable: size > 0,
+            is_readable,
             eof: false,
             has_errored: false,
         }
