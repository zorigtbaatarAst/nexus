@@ -65,6 +65,12 @@ impl Default for WriteFrame {
 
 impl From<BytesMut> for ReadFrame {
     fn from(mut buffer: BytesMut) -> Self {
+        // Only enter the `framing` state if the buffer actually holds bytes to
+        // decode. Using the capacity here would make an empty (but reserved)
+        // buffer, such as one recycled via `into_parts`, trigger a spurious
+        // `decode` call before anything has been read from the underlying IO.
+        let is_readable = !buffer.is_empty();
+
         let size = buffer.capacity();
         if size < INITIAL_CAPACITY {
             buffer.reserve(INITIAL_CAPACITY - size);
@@ -72,7 +78,7 @@ impl From<BytesMut> for ReadFrame {
 
         Self {
             buffer,
-            is_readable: size > 0,
+            is_readable,
             eof: false,
             has_errored: false,
         }
