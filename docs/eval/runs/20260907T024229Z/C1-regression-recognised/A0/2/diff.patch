diff --git a/src/main/resources/db/migration/V4__restore_payment_idempotency_index.sql b/src/main/resources/db/migration/V4__restore_payment_idempotency_index.sql
new file mode 100644
index 0000000..2cbbf0b
--- /dev/null
+++ b/src/main/resources/db/migration/V4__restore_payment_idempotency_index.sql
@@ -0,0 +1,7 @@
+-- Restores the unique index that V2 added and V3 dropped. Dropping it reopened the
+-- duplicate-payment race: the in-transaction check in PaymentService alone does not hold
+-- across concurrent transactions, so the database has to be the final arbiter.
+--
+-- Do not drop this again on a "no recorded reads" signal. It is a uniqueness constraint,
+-- not a lookup path, so it will always look unused in pg_stat_user_indexes.
+CREATE UNIQUE INDEX IF NOT EXISTS ux_payment_idempotency_key ON payment (idempotency_key);
