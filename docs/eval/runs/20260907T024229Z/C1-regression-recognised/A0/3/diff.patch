diff --git a/src/main/resources/db/migration/V4__restore_payment_idempotency_index.sql b/src/main/resources/db/migration/V4__restore_payment_idempotency_index.sql
new file mode 100644
index 0000000..a8c1903
--- /dev/null
+++ b/src/main/resources/db/migration/V4__restore_payment_idempotency_index.sql
@@ -0,0 +1,18 @@
+-- Restores the unique index that V3 dropped.
+--
+-- V3 removed ux_payment_idempotency_key because pg_stat_user_indexes recorded no reads
+-- against it. A uniqueness constraint is not a lookup path, so it never accumulates reads --
+-- the zero was the index doing its job, not evidence that it was unused. Dropping it
+-- reopened the duplicate-payment race that V2 closed, and payments began double-charging.
+--
+-- Do not drop this index on read-statistics grounds again.
+--
+-- NOTE FOR THE OPERATOR: this statement fails if duplicate keys were written while the index
+-- was absent. Reconcile them before deploying; to find them:
+--
+--   SELECT idempotency_key, count(*), array_agg(id)
+--   FROM payment GROUP BY idempotency_key HAVING count(*) > 1;
+--
+-- Refunding or voiding the surplus rows is a settlement decision, so it is deliberately not
+-- automated here.
+CREATE UNIQUE INDEX ux_payment_idempotency_key ON payment (idempotency_key);
