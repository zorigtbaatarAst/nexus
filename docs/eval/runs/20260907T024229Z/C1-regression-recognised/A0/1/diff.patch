@@ -0,0 +1,12 @@
+-- Restores the unique index V2 added and V3 dropped by mistake.
+--
+-- DO NOT DROP THIS INDEX. It is never read as a lookup path, so index-usage tooling
+-- (pg_stat_user_indexes and friends) will keep reporting it as unused. It is not: it is the
+-- uniqueness constraint that makes the database the final arbiter of payment idempotency.
+-- The application check in PaymentService#create is an optimisation that races on a cluster;
+-- without this index, concurrent requests carrying the same idempotency key both insert and
+-- the customer is charged twice.
+--
+-- Duplicate rows created while the index was missing must be reconciled before this runs,
+-- or the CREATE will fail. See the recovery query in the incident notes.
+CREATE UNIQUE INDEX ux_payment_idempotency_key ON payment (idempotency_key);
