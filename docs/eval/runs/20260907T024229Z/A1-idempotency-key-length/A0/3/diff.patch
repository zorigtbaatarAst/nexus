+-- The new upstream provider issues idempotency keys longer than the 64 characters V1 allowed.
+-- Widening a varchar in place is a catalog-only change in Postgres, so no table rewrite.
+ALTER TABLE payment ALTER COLUMN idempotency_key TYPE VARCHAR(128);
