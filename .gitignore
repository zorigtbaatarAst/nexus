# Cargo build output (the workspace lands here from the MVP onward)
/target/
**/*.rs.bk

# BugHunter's own local state, when it runs on itself
.nexus/bughunter.db
.nexus/bughunter.db-wal
.nexus/bughunter.db-shm
.nexus/cache/
.nexus/generated-tests/
.nexus/audit.log

# Editor and OS noise
*.swp
*.swo
.idea/
# Eclipse JDT / jdtls writes these next to any pom.xml or build.gradle it finds, and the
# fixture blobs are build files.
.project
.classpath
.settings/
.vscode/
.DS_Store

# graphify's knowledge graph — derived, 11 MB, and regenerable in one command.
# docs/architecture/03-current-state.md already states the practice: the output is
# not committed. Committing it would also freeze a snapshot that goes stale the
# moment anyone edits a file, which is the failure mode Nexus itself exists to fix.
graphify-out/
